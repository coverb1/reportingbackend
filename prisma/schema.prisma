generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// =========================
// REPORT ENUMS
// =========================

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  FORWARDED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportCategory {
  ROADS
  WATER
  STREET_LIGHTING
  WASTE
  DRAINAGE
  PUBLIC_INFRASTRUCTURE
}


// =========================
// USER ROLES
// =========================

enum Role {
  CITIZEN
  VILLAGE_LEADER
  CELL_LEADER
  SECTOR_LEADER
  DISTRICT_ADMIN
  SUPER_ADMIN
}


// =========================
// USER
// =========================

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  phone    String?

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  sectorId String?
  sector   Sectors? @relation(fields: [sectorId], references: [id])

  cellId String?
  cell   Cell? @relation(fields: [cellId], references: [id])

  villageId String?
  village   Village? @relation(fields: [villageId], references: [id])

  role Role @default(CITIZEN)

  resetToken       String?
  resetTokenExpiry DateTime?

  reports Report[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}


// =========================
// REPORT
// =========================

model Report {
  id String @id @default(cuid())

  title       String
  description String

  category ReportCategory
  status   ReportStatus   @default(PENDING)
  priority ReportPriority @default(MEDIUM)

  specificLocation String?
  isPublic         Boolean @default(true)
  photoUrl         String?

  // Citizen who created the report
  citizenId String
  citizen   User @relation(fields: [citizenId], references: [id])

  // Location hierarchy
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  sectorId String
  sector   Sectors @relation(fields: [sectorId], references: [id])

  cellId String
  cell   Cell @relation(fields: [cellId], references: [id])

  villageId String
  village   Village @relation(fields: [villageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// =========================
// DISTRICT
// =========================

model District {
  id   String @id @default(cuid())
  name String @unique

  sectors Sectors[]
  users   User[]
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// =========================
// SECTOR
// =========================

model Sectors {
  id         String @id @default(cuid())
  name       String
  districtId String

  district District @relation(fields: [districtId], references: [id])

  cells  Cell[]
  users  User[]
  reports Report[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@unique([name, districtId])
}


// =========================
// CELL
// =========================

model Cell {
  id       String @id @default(cuid())
  name     String
  SectorId String

  Sector  Sectors   @relation(fields: [SectorId], references: [id])
  village Village[]
  users   User[]
  reports Report[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@unique([name, SectorId])
}


// =========================
// VILLAGE
// =========================

model Village {
  id     String @id @default(cuid())
  name   String
  cellId String

  cell    Cell     @relation(fields: [cellId], references: [id])
  users   User[]
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, cellId])
}